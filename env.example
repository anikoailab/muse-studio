# Muse Studio - keys file
# Copy me:  cp env.example env.local   then fill in the values below.
# Load order: (1) real environment variable, (2) ./env.local, (3) ./.env, (4) ~/.config/muse-studio/.env
# env.local is gitignored - keys never leave this machine.

# --- The Designer: GPT Image 2 via Fal (https://fal.ai -> API keys) ---
FAL_KEY=

# --- The Thinker: Claude via OpenRouter (https://openrouter.ai -> settings -> API keys) ---
OPENROUTER_API_KEY=
# vision-capable model for ideas + brand enrichment (default anthropic/claude-sonnet-4.6)
OPENROUTER_IDEAS_MODEL=
# text-only fallback model (unused by default)
OPENROUTER_MODEL=

# --- The Publisher: Blotato (https://my.blotato.com -> settings -> API) ---
BLOTATO_API_KEY=
# OPTIONAL default Instagram account id. Normally leave blank - the app has an
# account picker, and each client picks their own connected account in the UI.
BLOTATO_IG_ACCOUNT_ID=

# --- Access gate (for hosted deploys). Leave blank locally = no login needed. ---
STUDIO_USER=
STUDIO_PASSWORD=

# --- Rebranding (Tailor stage): rename the app without touching code ---
# APP_NAME=Muse Studio
# APP_URL=https://muse-studio.local
